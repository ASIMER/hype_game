extends Node
## Client-side SFX + ambient layer.  Listens to the Events bus and plays
## procedurally-generated WAV sounds in reaction to gameplay.
## Mirrors AssetRegistry's guarded-fallback pattern: a missing file is
## skipped silently so the game ALWAYS runs with zero audio assets.
##
## Audio is purely local: it only reads the (already-replicated) Events
## signals, never networks anything itself.
## HEADLESS SAFETY: all looping bed players + UI-button wiring are
## guarded by DisplayServer.get_name() != "headless" so dedicated servers
## never touch audio hardware.

# ---------------------------------------------------------------------------
# Sound map — logical id -> res path (all .wav; generated by tools/audio/gen_audio.py)
# ---------------------------------------------------------------------------
const SOUNDS := {
	"shot":           "res://assets/audio/shot.wav",
	"hit":            "res://assets/audio/hit.wav",
	"explosion":      "res://assets/audio/explosion.wav",
	"player_death":   "res://assets/audio/player_death.wav",
	"extract_beep":   "res://assets/audio/extract_beep.wav",
	"extract_done":   "res://assets/audio/extract_done.wav",
	"extract_cancel": "res://assets/audio/extract_cancel.wav",
	"wave_alert":     "res://assets/audio/wave_alert.wav",
	"win":            "res://assets/audio/win.wav",
	"lose":           "res://assets/audio/lose.wav",
	# New
	"footstep1":      "res://assets/audio/footstep1.wav",
	"footstep2":      "res://assets/audio/footstep2.wav",
	"footstep3":      "res://assets/audio/footstep3.wav",
	"reload":         "res://assets/audio/reload.wav",
	"weapon_switch":  "res://assets/audio/weapon_switch.wav",
	"ui_click":       "res://assets/audio/ui_click.wav",
	"heartbeat":      "res://assets/audio/heartbeat.wav",
	"ambient":        "res://assets/audio/ambient.wav",
	"music":          "res://assets/audio/music.wav",
}

## Per-sound volume trim (dB).  Unlisted sounds play at 0 dB.
const SOUND_DB := {
	"shot":          -8.0,
	"hit":           -4.0,
	"explosion":     -3.0,
	"player_death":   0.0,
	"win":           -2.0,
	"lose":          -2.0,
	"footstep1":    -12.0,
	"footstep2":    -12.0,
	"footstep3":    -12.0,
	"reload":        -6.0,
	"weapon_switch": -8.0,
	"ui_click":     -10.0,
	"heartbeat":    -14.0,
	"ambient":      -18.0,
	"music":        -20.0,
}

## Master toggle + trim.  Public so a settings menu can drive them later.
var enabled    := true
var master_db  := -3.0

# ---------------------------------------------------------------------------
# Shot throttle (weapon_fired fires ~8/s in full auto)
# ---------------------------------------------------------------------------
const SHOT_MIN_INTERVAL := 0.05
var _last_shot_time := -1.0

# ---------------------------------------------------------------------------
# Stream cache (null when the file is absent)
# ---------------------------------------------------------------------------
var _streams: Dictionary = {}

# ---------------------------------------------------------------------------
# Non-positional round-robin pool for one-shot UI / global sounds
# ---------------------------------------------------------------------------
const POOL_SIZE := 8
var _pool: Array[AudioStreamPlayer] = []
var _pool_next := 0

# ---------------------------------------------------------------------------
# Footstep state
# ---------------------------------------------------------------------------
var _local_player: Node = null
var _footstep_timer  := 0.0   # countdown to next footstep
const FOOTSTEP_WALK_INTERVAL   := 0.50
const FOOTSTEP_SPRINT_INTERVAL := 0.32
const FOOTSTEP_SPEED_THRESHOLD := 1.0   # horizontal m/s below which no footstep

# ---------------------------------------------------------------------------
# Low-HP heartbeat
# ---------------------------------------------------------------------------
var _heartbeat_player: AudioStreamPlayer = null
const HEARTBEAT_HP_THRESHOLD := 0.30   # ratio of max_health

# ---------------------------------------------------------------------------
# Looping ambient + music beds
# ---------------------------------------------------------------------------
var _ambient_player: AudioStreamPlayer = null
var _music_player:   AudioStreamPlayer = null
const AMBIENT_BASE_DB := -18.0
const MUSIC_BASE_DB   := -20.0
const MUSIC_WAVE_DB   := -16.0   # slight raise during active waves

# ---------------------------------------------------------------------------
# _ready
# ---------------------------------------------------------------------------
func _ready() -> void:
	# Cache streams; absent files resolve to null.
	for id in SOUNDS:
		var path: String = SOUNDS[id]
		if ResourceLoader.exists(path):
			var res := load(path)
			if res is AudioStream:
				_streams[id] = res
				continue
		_streams[id] = null

	# Round-robin pool for non-positional one-shots.
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_pool.append(p)

	# Dedicated looping players (bed tracks + heartbeat).
	_heartbeat_player = _make_looping_player("heartbeat", SOUND_DB.get("heartbeat", 0.0))
	_heartbeat_player.volume_db = -80.0   # start silent
	_heartbeat_player.playing = false

	var _is_headless := DisplayServer.get_name() == "headless"

	if not _is_headless:
		_ambient_player = _make_looping_player("ambient", AMBIENT_BASE_DB)
		_ambient_player.volume_db = -80.0

		_music_player = _make_looping_player("music", MUSIC_BASE_DB)
		_music_player.volume_db = -80.0

		# Wire UI click to all buttons added after this point.
		get_tree().node_added.connect(_on_node_added)

	# Events bus connections.
	Events.weapon_fired.connect(_on_weapon_fired)
	Events.damage_dealt.connect(_on_damage_dealt)
	Events.entity_died.connect(_on_entity_died)
	Events.extraction_started.connect(_on_extraction_started)
	Events.extraction_completed.connect(_on_extraction_completed)
	Events.extraction_cancelled.connect(_on_extraction_cancelled)
	Events.wave_started.connect(_on_wave_started)
	Events.match_won.connect(_on_match_won)
	Events.match_lost.connect(_on_match_lost)
	Events.grenade_exploded.connect(_on_grenade_exploded)
	Events.reload_started.connect(_on_reload_started)
	Events.weapon_switched.connect(_on_weapon_switched)
	Events.local_player_spawned.connect(_on_local_player_spawned)
	Events.player_health_changed.connect(_on_player_health_changed)
	if Events.has_signal("match_started"):
		Events.match_started.connect(_on_match_started)

# ---------------------------------------------------------------------------
# _process — footstep ticker (independent of player input, reads velocity)
# ---------------------------------------------------------------------------
func _process(delta: float) -> void:
	if not enabled or _local_player == null:
		return
	if not is_instance_valid(_local_player):
		_local_player = null
		return

	# Footstep logic: player must be on the floor and moving.
	if not _local_player.has_method("is_on_floor"):
		return
	if not _local_player.is_on_floor():
		return

	var vel: Vector3 = _local_player.velocity if "velocity" in _local_player else Vector3.ZERO
	var horiz_speed := Vector2(vel.x, vel.z).length()
	if horiz_speed < FOOTSTEP_SPEED_THRESHOLD:
		return

	_footstep_timer -= delta
	if _footstep_timer > 0.0:
		return

	# Pick interval based on speed.
	var is_sprinting := horiz_speed > (Settings.PLAYER_SPRINT_SPEED * 0.6)
	_footstep_timer = FOOTSTEP_SPRINT_INTERVAL if is_sprinting else FOOTSTEP_WALK_INTERVAL

	# Play random variant positionally.
	var variant := "footstep%d" % (randi() % 3 + 1)
	_play_at(variant, _local_player)

# ---------------------------------------------------------------------------
# Event handlers — existing
# ---------------------------------------------------------------------------

func _on_grenade_exploded(_world_pos: Vector3, _damage: float, _radius: float) -> void:
	_play("explosion")

func _on_weapon_fired(_shooter: Node, _weapon_id: String) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if _last_shot_time >= 0.0 and now - _last_shot_time < SHOT_MIN_INTERVAL:
		return
	_last_shot_time = now
	_play("shot")

func _on_damage_dealt(target: Node, _amount: float, _source: Node) -> void:
	_play_at("hit", target)

func _on_entity_died(entity: Node, _killer: Node) -> void:
	if entity != null and entity.is_in_group("players"):
		_play_at("player_death", entity)
	else:
		_play_at("explosion", entity)

func _on_extraction_started(_player: Node, _zone: Node) -> void:
	_play("extract_beep")

func _on_extraction_completed(_player: Node) -> void:
	_play("extract_done")

func _on_extraction_cancelled(_player: Node) -> void:
	_play("extract_cancel")

func _on_wave_started(_wave_number: int, _enemy_count: int) -> void:
	_play("wave_alert")
	# Raise music slightly while a wave is active.
	if _music_player != null:
		_tween_volume(_music_player, MUSIC_WAVE_DB, 1.5)

func _on_match_won() -> void:
	_play("win")
	_fade_beds_out()

func _on_match_lost() -> void:
	_play("lose")
	_fade_beds_out()

# ---------------------------------------------------------------------------
# Event handlers — new
# ---------------------------------------------------------------------------

func _on_reload_started(_weapon_id: String) -> void:
	_play("reload")

func _on_weapon_switched(_weapon_id: String, _ammo: int, _reserve: int) -> void:
	_play("weapon_switch")

func _on_local_player_spawned(player: Node) -> void:
	_local_player   = player
	_footstep_timer = 0.0
	_on_match_started()

func _on_match_started() -> void:
	if DisplayServer.get_name() == "headless":
		return
	# Start ambient + music beds.
	if _ambient_player != null and _streams.get("ambient") != null:
		var amb: AudioStream = _streams["ambient"]
		if amb is AudioStreamWAV:
			(amb as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		_ambient_player.stream    = amb
		_ambient_player.volume_db = -80.0
		_ambient_player.play()
		_tween_volume(_ambient_player, AMBIENT_BASE_DB + master_db, 3.0)
	if _music_player != null and _streams.get("music") != null:
		var mus: AudioStream = _streams["music"]
		if mus is AudioStreamWAV:
			(mus as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		_music_player.stream    = mus
		_music_player.volume_db = -80.0
		_music_player.play()
		_tween_volume(_music_player, MUSIC_BASE_DB + master_db, 4.0)

func _on_player_health_changed(player: Node, current: float, max_hp: float) -> void:
	# Only react to the local player.
	if _local_player == null or player != _local_player:
		return
	if max_hp <= 0.0:
		return

	var ratio := current / max_hp
	if ratio < HEARTBEAT_HP_THRESHOLD and current > 0.0:
		# Start/update heartbeat.
		if not _heartbeat_player.playing:
			if _streams.get("heartbeat") != null:
				var hb: AudioStream = _streams["heartbeat"]
				if hb is AudioStreamWAV:
					(hb as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
				_heartbeat_player.stream = hb
				_heartbeat_player.play()
		# Volume and pitch rise as HP falls.
		var urgency     := 1.0 - ratio / HEARTBEAT_HP_THRESHOLD   # 0..1
		var target_db: float = float(SOUND_DB.get("heartbeat", -14.0)) + master_db + urgency * 8.0
		_heartbeat_player.volume_db   = lerpf(_heartbeat_player.volume_db, target_db, 0.1)
		_heartbeat_player.pitch_scale = 1.0 + urgency * 0.4
	else:
		# Above threshold or dead — stop heartbeat.
		if _heartbeat_player.playing:
			_tween_volume(_heartbeat_player, -80.0, 0.5)
			# Delay stopping so tween can finish.
			get_tree().create_timer(0.6).timeout.connect(
				func() -> void:
					if _heartbeat_player != null:
						_heartbeat_player.stop()
			)

# ---------------------------------------------------------------------------
# UI button auto-wiring
# ---------------------------------------------------------------------------

func _on_node_added(node: Node) -> void:
	if not (node is BaseButton):
		return
	var btn := node as BaseButton
	if btn.pressed.is_connected(_on_button_pressed):
		return
	btn.pressed.connect(_on_button_pressed)

func _on_button_pressed() -> void:
	_play("ui_click")

# ---------------------------------------------------------------------------
# Playback helpers
# ---------------------------------------------------------------------------

## Non-positional one-shot from the round-robin pool.
func _play(id: String) -> void:
	if not enabled:
		return
	var stream: AudioStream = _streams.get(id, null)
	if stream == null:
		return
	var p := _pool[_pool_next]
	_pool_next = (_pool_next + 1) % POOL_SIZE
	p.stream    = stream
	p.volume_db = master_db + SOUND_DB.get(id, 0.0)
	p.play()

## Positional one-shot at a Node3D; falls back to the pool for non-3D nodes.
## The AudioStreamPlayer3D is self-freeing so the pool is never starved.
func _play_at(id: String, where: Node) -> void:
	if not enabled:
		return
	var stream: AudioStream = _streams.get(id, null)
	if stream == null:
		return
	if where is Node3D and (where as Node3D).is_inside_tree():
		var p := AudioStreamPlayer3D.new()
		p.stream       = stream
		p.bus          = "Master"
		p.volume_db    = master_db + SOUND_DB.get(id, 0.0)
		p.max_distance = 60.0
		p.finished.connect(p.queue_free)
		(where as Node3D).add_child(p)
		p.global_position = (where as Node3D).global_position
		p.play()
	else:
		_play(id)

## Creates a dedicated child AudioStreamPlayer with loop mode set.
func _make_looping_player(id: String, vol_db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus       = "Master"
	p.volume_db = vol_db
	add_child(p)
	# Loop mode is set after the stream is assigned (see _on_match_started).
	# We stash the id so we can re-apply it when the stream is loaded.
	p.set_meta("sound_id", id)
	return p

## Tween a player's volume_db to target over duration_s.
func _tween_volume(player: AudioStreamPlayer, target_db: float, duration_s: float) -> void:
	var tw := create_tween()
	tw.tween_property(player, "volume_db", target_db, duration_s)

## Fade both ambient and music beds out on match end.
func _fade_beds_out() -> void:
	if _ambient_player != null:
		_tween_volume(_ambient_player, -80.0, 3.0)
	if _music_player != null:
		_tween_volume(_music_player, -80.0, 3.0)
	# Stop heartbeat immediately.
	if _heartbeat_player != null and _heartbeat_player.playing:
		_tween_volume(_heartbeat_player, -80.0, 0.5)
		get_tree().create_timer(0.6).timeout.connect(
			func() -> void:
				if _heartbeat_player != null:
					_heartbeat_player.stop()
		)
	_local_player = null
