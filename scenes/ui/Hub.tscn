border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.91, 0.64, 0.24, 1.0)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; ── Root ─────────────────────────────────────────────────────────────────────
[node name="Hub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
process_mode = 4
script = ExtResource("1_hub")

; Background fill (#0f1318 — same dark bg as MainMenu/Workshop).
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.059, 0.075, 0.094, 1)

; Vignette overlay.
[node name="Vignette" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = SubResource("Tex_vignette")
expand_mode = 1
stretch_mode = 0

; ── Outer layout (Header + Body + Footer stacked vertically) ─────────────────
[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

; ── HEADER (title row + tab bar stacked in a PanelContainer) ─────────────────
[node name="Header" type="PanelContainer" parent="Layout"]
layout_mode = 2
theme_override_styles/panel = SubResource("SB_header")

[node name="HeaderVBox" type="VBoxContainer" parent="Layout/Header"]
layout_mode = 2
theme_override_constants/separation = 10

; Title row: "HUB" label (amber, 48 pt) + spacer + currency readout.
[node name="HRow" type="HBoxContainer" parent="Layout/Header/HeaderVBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleBox" type="VBoxContainer" parent="Layout/Header/HeaderVBox/HRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Layout/Header/HeaderVBox/HRow/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.64, 0.24, 1)
theme_override_font_sizes/font_size = 48
text = "HUB"

[node name="Subtitle" type="Label" parent="Layout/Header/HeaderVBox/HRow/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.247, 0.71, 0.79, 1)
theme_override_font_sizes/font_size = 14
text = "STASH // LOADOUT // WORKSHOP"

; Currency readout — updated live by hub.gd on Events.currency_changed.
[node name="CurrencyLabel" type="Label" parent="Layout/Header/HeaderVBox/HRow"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.91, 0.64, 0.24, 1)
theme_override_font_sizes/font_size = 26
text = "CR 0"
horizontal_alignment = 2

; Tab bar — three radio-style Buttons (hub.gd reads them in order: STASH, LOADOUT, WORKSHOP).
[node name="TabBar" type="HBoxContainer" parent="Layout/Header/HeaderVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="StashBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "STASH"

[node name="LoadoutBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "LOADOUT"

[node name="WorkshopBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "WORKSHOP"

[node name="ShopBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "SHOP"

[node name="QuestsBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "QUESTS"

[node name="GunsmithBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
