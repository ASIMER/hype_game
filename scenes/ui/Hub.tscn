[gd_scene load_steps=8 format=3 uid="uid://c0archub0001"]

[ext_resource type="Script" path="res://scripts/ui/hub.gd" id="1_hub"]

; Panel StyleBox — dark bg with subtle border (matches Workshop/MainMenu/SettingsMenu).
[sub_resource type="StyleBoxFlat" id="SB_panel"]
content_margin_left = 20.0
content_margin_top = 16.0
content_margin_right = 20.0
content_margin_bottom = 16.0
bg_color = Color(0.106, 0.133, 0.157, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.235, 0.3, 0.36, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.45)
shadow_size = 14

; Footer / header bar StyleBox — slightly darker strip, top border only for footer.
[sub_resource type="StyleBoxFlat" id="SB_footer"]
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0
bg_color = Color(0.085, 0.106, 0.13, 0.95)
border_width_top = 1
border_color = Color(0.235, 0.3, 0.36, 0.7)

; Header bar uses the same panel style as the section header strip.
[sub_resource type="StyleBoxFlat" id="SB_header"]
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0
bg_color = Color(0.085, 0.106, 0.13, 0.95)
border_width_bottom = 1
border_color = Color(0.235, 0.3, 0.36, 0.7)

; Vignette gradient (radial, centre transparent → edge dark).
[sub_resource type="Gradient" id="Grad_vignette"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0, 0, 0, 0, 0, 0, 0, 0.55)

[sub_resource type="GradientTexture2D" id="Tex_vignette"]
gradient = SubResource("Grad_vignette")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 1)

; Deploy button style (amber accent, larger — matches Workshop).
[sub_resource type="StyleBoxFlat" id="SB_deploy_normal"]
content_margin_left = 24.0
content_margin_top = 0.0
content_margin_right = 24.0
content_margin_bottom = 0.0
bg_color = Color(0.55, 0.36, 0.08, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.91, 0.64, 0.24, 1.0)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="SB_deploy_hover"]
content_margin_left = 24.0
content_margin_top = 0.0
content_margin_right = 24.0
content_margin_bottom = 0.0
bg_color = Color(0.70, 0.46, 0.10, 1.0)
