[node name="RaiderBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(120, 36)
layout_mode = 2
text = "RAIDER"

[node name="CharacterBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "CHARACTER"

[node name="RivalsBtn" type="Button" parent="Layout/Header/HeaderVBox/TabBar"]
custom_minimum_size = Vector2(120, 36)
layout_mode = 2
text = "RIVALS"

; ── BODY (content area — hub.gd adds tab scenes here) ────────────────────────
[node name="Body" type="MarginContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 8

; ContentArea is the container hub.gd adds tab children into.
[node name="ContentArea" type="Control" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

; ── FOOTER ────────────────────────────────────────────────────────────────────
[node name="Footer" type="PanelContainer" parent="Layout"]
layout_mode = 2
theme_override_styles/panel = SubResource("SB_footer")

[node name="FooterRow" type="HBoxContainer" parent="Layout/Footer"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

; Difficulty selector + description (left side of footer).
[node name="DiffVBox" type="VBoxContainer" parent="Layout/Footer/FooterRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="DiffOption" type="OptionButton" parent="Layout/Footer/FooterRow/DiffVBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="DiffDesc" type="Label" parent="Layout/Footer/FooterRow/DiffVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.50, 0.55, 1)
theme_override_font_sizes/font_size = 13
text = ""
