; Engine configuration file.
; Arc Raiders-style co-op extraction shooter — vertical slice
; Godot 4.6.3 stable

config_version=5

[application]

config/name="Hype Raiders"
config/description="Co-op third-person extraction shooter vertical slice"
run/main_scene="res://scenes/boot/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/Events.gd"
AudioManager="*res://autoload/AudioManager.gd"
Settings="*res://autoload/Settings.gd"
AssetRegistry="*res://autoload/AssetRegistry.gd"
IconRenderer="*res://autoload/IconRenderer.gd"
ItemCatalog="*res://autoload/ItemCatalog.gd"
GameState="*res://autoload/GameState.gd"
MetaProgression="*res://autoload/MetaProgression.gd"
Stash="*res://autoload/Stash.gd"
Crafting="*res://autoload/Crafting.gd"
Quests="*res://autoload/Quests.gd"
NetworkManager="*res://autoload/NetworkManager.gd"
RaidManager="*res://autoload/RaidManager.gd"
ExtractionDirector="*res://autoload/ExtractionDirector.gd"
AIDirector="*res://autoload/ai_director.gd"
WorldEventDirector="*res://autoload/world_event_director.gd"
NemesisDirector="*res://autoload/nemesis_director.gd"
PowerCoreDirector="*res://autoload/power_core_director.gd"
Progression="*res://autoload/progression.gd"
QuestDirector="*res://autoload/quest_director.gd"
AgentBridge="*res://autoload/AgentBridge.gd"
SettingsManager="*res://autoload/SettingsManager.gd"
ServerBrowser="*res://autoload/ServerBrowser.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://locale/ui.ru.translation")
locale/fallback="en"

