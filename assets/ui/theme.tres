[gd_resource type="Theme" load_steps=18 format=3 uid="uid://c0arcuitheme01"]

; "Military glass" UI theme (Battlefield 2042 / Arc Raiders look). Dark TRANSLUCENT
; panels over a blurred backdrop, thin light borders, chamfered (asymmetric) corners,
; amber accent + glow on hover/focus, teal progress fills. Set as gui/theme/custom in
; project.godot so every default Control inherits it. Body font = Oswald, heading face
; = Russo One (via the HeaderLarge/HeaderSmall type variations). Both ship Cyrillic for
; the RU locale. Palette: bg #12181d, glass #10141880, accent amber #e8a33d, teal #3fb6c9.
; Shared in-code factories mirror this in scripts/ui/ui_style.gd (UIStyle).

[ext_resource type="FontFile" uid="uid://bxwn6xlaljjyn" path="res://assets/fonts/Oswald-VariableFont_wght.ttf" id="1_oswald"]
[ext_resource type="FontFile" uid="uid://crfxlthyimj7g" path="res://assets/fonts/RussoOne-Regular.ttf" id="2_russo"]

