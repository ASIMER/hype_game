[gd_resource type="Theme" load_steps=14 format=3 uid="uid://c0arcuitheme01"]

; Dark sci-fi / industrial UI theme (Arc Raiders-ish). Dark panels, amber accent,
; teal progress fills. Set as gui/theme/custom in project.godot so every default
; Control inherits it. Palette: bg #12181d, panel #1b2228, accent amber #e8a33d,
; teal #3fb6c9, text #d8dee4.

