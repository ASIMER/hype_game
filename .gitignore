# --- Godot ---
# Import/cache dir — regenerated on first import; never commit.
.godot/
# Export output + logs
/export/
*.log

# --- IDE / editor ---
.idea/
.vs/
.vscode/

# --- Python (agent harness) ---
__pycache__/
*.pyc
# Per-worktree MCP port pin (written by launch_agents.ps1; differs per worktree/machine)
/tools/agent/.agent_port

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Scratch / temp test files (root-level dotfiles + *_tmp.py) ---
/*_tmp.py
/.s_*
/.h_err.txt
/.c_err.txt
/.di_*.txt
/.smoke*

# NOTE: *.import and *.uid ARE committed (Godot resource metadata), as is assets/.

# Asset research scratch (downloads + screenshots; not shipped)
/asset-research/

# Debug screenshots (local)
/debug_screens/
